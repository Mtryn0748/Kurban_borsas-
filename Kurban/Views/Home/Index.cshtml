@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2>Kurbanlık Takip Otomasyonu — Yönetim Paneli</h2>
        <p class="text-muted">İşletmenizin anlık genel durumu ve canlı verileri</p>
    </div>

    <div class="row" style="display: flex; gap: 20px; margin-bottom: 30px;">

        <div class="card" style="flex: 1; min-width: 200px; border-left: 5px solid var(--accent-blue);">
            <div style="font-size: 14px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Toplam Hayvan</div>
            <div style="font-size: 32px; font-weight: 700; margin-top: 10px; color: var(--accent-blue);">@ViewBag.TotalAnimals</div>
        </div>

        <div class="card" style="flex: 1; min-width: 200px; border-left: 5px solid var(--accent-green);">
            <div style="font-size: 14px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Satılan Kurbanlık</div>
            <div style="font-size: 32px; font-weight: 700; margin-top: 10px; color: var(--accent-green);">@ViewBag.SoldAnimals</div>
        </div>

        <div class="card" style="flex: 1; min-width: 200px; border-left: 5px solid #eab308;">
            <div style="font-size: 14px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Bekleyen (Stok)</div>
            <div style="font-size: 32px; font-weight: 700; margin-top: 10px; color: #eab308;">@ViewBag.UnsoldAnimals</div>
        </div>

        <div class="card" style="flex: 1; min-width: 200px; border-left: 5px solid #8b5cf6;">
            <div style="font-size: 14px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Toplam Ciro</div>
            <div style="font-size: 28px; font-weight: 700; margin-top: 10px; color: #8b5cf6;">@ViewBag.TotalRevenue.ToString("C2")</div>
        </div>

    </div>
    <div class="row mt-5">
        <div class="col-md-6 m-auto">
            <div class="card shadow border-0" style="border-radius: 12px; padding: 20px; background: #fff;">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h5 class="fw-bold mb-0 text-dark text-center"><i class="fa-solid fa-chart-pie text-primary"></i> Çiftlik Tür/Kategori Dağılım Raporu</h5>
                </div>
                <div class="card-body">
                    <canvas id="breedDoughnutChart" style="max-height: 280px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Controller'dan gelen verileri JavaScript array'ine eşliyoruz
        const labelsData = @Json.Serialize(ViewBag.ChartLabels);
        const countsData = @Json.Serialize(ViewBag.ChartData);

        const ctx = document.getElementById('breedDoughnutChart').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labelsData,
                datasets: [{
                    label: 'Hayvan Sayısı',
                    data: countsData,
                    backgroundColor: [
                        '#3b82f6', // Mavi
                        '#10b981', // Yeşil
                        '#f59e0b', // Turuncu
                        '#ec4899', // Pembe
                        '#8b5cf6'  // Mor
                    ],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { boxWidth: 15, font: { size: 12 } }
                    }
                }
            }
        });
    </script>
    <p>Buraya daha grafik gelecek....</p>
</div>