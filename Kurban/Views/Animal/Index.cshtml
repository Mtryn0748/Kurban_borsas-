@model IEnumerable<Kurban.Models.Animal>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Çiftlik Canlı Hayvan Envanteri</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Yeni Hayvan Kaydet</a>

    </div>

    <div class="card shadow">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Küpe No</th>
                    <th>Irk / Tür</th>
                    <th>Yaş / Dönem</th>
                    <th>Ağırlık</th>
                    <th>Envanter Sınıfı</th>
                    <th>Satış Durumu</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.AnimalEarringNumber</strong></td>
                        <td>@item.AnimalName (@(item.Breed != null ? item.Breed.BreedName : "-"))</td>
                        <td>@item.Age</td>
                        <td>@item.AnimalWeight kg</td>
                        <td>
                            @if (item.InventoryStatus == "Satılık")
                            {
                                <span class="badge bg-info">Satılık</span>
                            }
                            else if (item.InventoryStatus == "Damızlık")
                            {

                                <span class="badge bg-warning text-dark">Damızlık</span>
                            }
                            else
                            {

                                <span class="badge bg-secondary">Yeni Doğan</span>
                            }
                        </td>
                        <td>
                            @if (!item.IsSold)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Düzenle</a>

                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('DİKKAT: @item.AnimalEarringNumber küpe numaralı hayvan envanterden tamamen silinecektir. Emin misiniz?')">
                                    <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border me-1"><i class="fa-solid fa-lock"></i> Sözleşmeli</span>
                            }

                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>