@model IEnumerable<Kurban.Models.Animal>

<div class="container mt-4">
    <h2>Canlı Hayvan Borsası (Satılık Stoklar)</h2>
    <p class="text-muted">Çiftliğimizde aktif satılık olan canlı hayvanlar ve taban piyasa referans değerleri</p>
    <hr />
    <div class="row">
        @foreach (var item in Model)
        {
            decimal referencePrice = (decimal)item.AnimalWeight * item.PricePerKg;
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0" style="border-radius: 15px; background: #fff; padding: 20px;">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@item.AnimalName (@(item.Breed?.BreedName))</h5>
                        <h6 class="card-subtitle mb-2 text-muted">Küpe No: @item.AnimalEarringNumber</h6>
                        <hr />
                        <p><strong>Canlı Ağırlık:</strong> @item.AnimalWeight kg</p>
                        <p><strong>Referans Canlı Fiyat:</strong> @item.PricePerKg.ToString("C2") / kg</p>
                        <p class="fs-5 text-secondaryfw-bold"><strong>Piyasa Ederi:</strong> @referencePrice.ToString("C2")</p>

                        <form asp-controller="Buyer" asp-action="SendBid" method="post" class="mt-3" style="background: #f8fafc; padding: 15px; border-radius: 10px;">

                            <input type="hidden" name="AnimalId" value="@item.Id" />

                            <div class="mb-2">
                                <label class="form-label" style="font-size:12px; font-weight:700; color: #1e293b;">Teklif Ettiğiniz Tutar (₺)</label>
                                <input type="number" name="OfferPrice" class="form-control form-control-sm" placeholder="Örn: 31500" required />
                            </div>

                            <div class="mb-2">
                                <input type="text" name="BuyerNote" class="form-control form-control-sm" placeholder="Pazarlık mesajınız..." />
                            </div>

                            <button type="submit" class="btn btn-sm btn-primary w-100">Teklifi Çiftliğe Gönder</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>